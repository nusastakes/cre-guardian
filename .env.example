# Private key used by the simulator to send transactions when you pass --broadcast (64 hex chars, no 0x).
# Use a testnet-only key. It needs MON on Monad testnet. Leave empty for read-only simulation.
CRE_ETH_PRIVATE_KEY=

# LLM provider keys. The workflow uses the provider named in config (anthropic or xkiro); the other may stay empty.
# With no key at all the workflow still runs on its rule-based risk check.
ANTHROPIC_API_KEY=
XKIRO_API_KEY=
